{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unirouter.local/schemas/endpoint-profile.v1.schema.json",
  "title": "UniRouter Endpoint Protocol Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "provider",
    "runtime_state",
    "conformance_level",
    "network_verified",
    "descriptor",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "const": "unirouter.endpoint-profile-manifest.v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^unirouter\\.[a-z0-9.-]+$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "runtime_state": {
      "enum": [
        "local_contract_only",
        "decision_gated_p7_d03"
      ]
    },
    "conformance_level": {
      "const": "fixture_verified"
    },
    "network_verified": {
      "const": false
    },
    "descriptor": {
      "type": "object"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "path",
          "sha256"
        ],
        "properties": {
          "fixture_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
