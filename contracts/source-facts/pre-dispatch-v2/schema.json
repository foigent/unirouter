{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://sources/unirouter/source-observation/v2/gateway-pre-dispatch-terminal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_instance", "org_id", "project_id", "request_id", "profile", "subject_kind", "subject_id", "observation_kind", "source_fact_id", "revision", "event_id", "occurred_at", "recorded_at", "coverage", "context_ref", "capture_expected", "runtime"],
  "properties": {
    "schema_version": {"const": "unirouter.source-observation.v2"},
    "source_instance": {"type": "string", "minLength": 1, "maxLength": 128},
    "org_id": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 19},
    "project_id": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 19},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "profile": {"const": "unirouter.runtime-observation.v2"},
    "subject_kind": {"const": "request"},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "observation_kind": {"const": "gateway_pre_dispatch_terminal"},
    "source_fact_id": {"type": "string", "pattern": "^uf1_[a-f0-9]{64}$"},
    "revision": {"const": "1"},
    "event_id": {"type": "string", "pattern": "^uf1_[a-f0-9]{64}$"},
    "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "coverage": {"const": "observed"},
    "context_ref": {"type": "string", "pattern": "^uf1_[a-f0-9]{64}$"},
    "capture_expected": {"const": ["gateway_pre_dispatch_terminal"]},
    "runtime": {"type": "object", "additionalProperties": false,
      "required": ["operation", "stream_mode", "admission", "provider", "local_delivery", "financial", "capture", "terminal_origin", "failure_code", "http_status"],
      "properties": {
        "operation": {"const": "openai.chat_completions.v1"},
        "stream_mode": {"const": "not_observed"},
        "admission": {"const": "authenticated"},
        "provider": {"const": "not_started"},
        "local_delivery": {"const": "not_started"},
        "financial": {"const": "not_created"},
        "capture": {"const": "observed"},
        "terminal_origin": {"const": "gateway_pre_dispatch"},
        "failure_code": {"const": "routing.no_route"},
        "http_status": {"const": "503"}
      }
    }
  }
}
