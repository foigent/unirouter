{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unirouter.local/contracts/unirouter.release-state-identity.v1.schema.json",
  "title": "UniRouter installed release identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_sequence", "version", "canonical_commit", "package_sha256", "trusted_key_id", "database_schema", "recorded_at", "observed_at"],
  "properties": {
    "schema_version": { "const": "unirouter.release-state-identity.v1" },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "canonical_commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "package_sha256": { "$ref": "#/$defs/sha256" },
    "trusted_key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$" },
    "database_schema": { "type": "string", "minLength": 1, "maxLength": 128 },
    "recorded_at": { "$ref": "#/$defs/time" },
    "observed_at": { "$ref": "#/$defs/time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "time": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
