{
  "name": "uniroute-frontend",
  "private": true,
  "version": "1.2.26",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run check:api-contracts && npm run check:react-compat && vite build && node scripts/check-bundle-budget.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:api-contracts": "node scripts/check-api-contract-debt.mjs",
    "check:react-compat": "node scripts/check-react-compatibility.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && npm run check:api-contracts && npm run check:react-compat"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.100.0",
    "@douyinfe/semi-theme-default": "^2.100.0",
    "@douyinfe/semi-ui": "^2.100.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.15.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "canvas": "^3.2.3",
    "jsdom": "^27.0.1",
    "msw": "^2.14.6",
    "playwright": "^1.61.1",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
