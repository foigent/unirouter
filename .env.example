# ==========================================
# UniRoute Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values.

# --- Server ---
LISTEN_PORT=8080
LOG_LEVEL=info
GIN_MODE=release
# Requested minimum drain window. Effective drain also covers supported request
# lifetime plus cancellation/finalization grace; /health/ready reports it.
# Ambiguous Provider attempts must not be automatically retried after timeout.
SHUTDOWN_TIMEOUT_SECONDS=120
# Must exceed the effective drain timeout (default 2040 seconds). Increase with
# longer STREAM_MAX_DURATION_SECONDS; runtime-ingress refuses insufficient grace.
UNIROUTER_STOP_GRACE_PERIOD=35m
# Source-build module proxy chain. Keep go.sum verification enabled; internal
# Targets in networks that cannot reach proxy.golang.org may set an approved
# mirror such as https://goproxy.cn,direct.
GOPROXY=https://proxy.golang.org,direct
# Bound Docker json-file logs for every long-running Compose service.
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=3

# --- Database (PostgreSQL) ---
DB_DSN=postgres://uniroute:password@postgres:5432/uniroute?sslmode=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Stable HMAC secret for API Key hashes. For existing deployments, set this to
# the current JWT_SECRET first, then rotate JWT_SECRET separately if needed.
API_KEY_HASH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_WITH_EXACTLY_32_BYTES
# Exact Response Cache stays disabled unless all three values are injected.
# The two key values are independent raw 32-byte secrets; never reuse
# JWT_SECRET, API_KEY_HASH_SECRET, ENCRYPTION_KEY, or commit real values.
# RESPONSE_CACHE_KEY_VERSION is a non-secret immutable version label. The V1
# process loads one version; rotation deliberately turns older entries into
# fail-closed misses until they expire instead of silently reusing key labels.
RESPONSE_CACHE_INDEX_KEY=
RESPONSE_CACHE_ENCRYPTION_KEY=
RESPONSE_CACHE_KEY_VERSION=
# Private completed-execution feed. Keep disabled until the jointly sequenced
# X-Insight activation, then set one stable non-secret deployment identity.
COMPLETED_EXECUTION_FEED_ENABLED=false
COMPLETED_EXECUTION_FEED_SOURCE_INSTANCE=
COMPLETED_EXECUTION_FEED_REFERENCE_MODE=legacy
# Product-local Connector agent. Stable is the only polling writer; canary is
# hard-disabled in its Compose overlay. The origin is one fixed HTTPS origin,
# never an invitation-supplied URL. Bindings are non-secret public authority;
# do not place invitation/control tokens or receiver bearers in this JSON.
XINSIGHT_CONNECTOR_AGENT_ENABLED=false
XINSIGHT_CONNECTOR_CONTROL_ORIGIN=
XINSIGHT_CONNECTOR_POLL_MILLISECONDS=1000
XINSIGHT_CONNECTOR_REQUEST_TIMEOUT_MILLISECONDS=5000
# Exact-case installation/deployment IDs and binding digest map to one /32 or
# /128, for example:
# [{"installation_id":"xci_AbCdEfGhIjKlMnOpQrStUv","x_deployment_id":"xid_ZyXwVuTsRqPoNmLkJiHgFe","network_binding_sha256":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","allowed_ip":"203.0.113.7/32"}]
XINSIGHT_CONNECTOR_RECEIVER_BINDINGS_JSON=[]
# Legacy asynchronous GPT Image V1 runtime. Canonical model authority rejects
# this path because it still dispatches through legacy channels/keys. It may be
# enabled only with an explicitly authorized legacy/verify compatibility
# process, an approved S3-compatible bucket, and the AWS SDK default credential
# chain. Do not commit access keys to this file.
ASYNC_MEDIA_ENABLED=false
# Keep false while staging storage/worker readiness. When runtime is true and
# admission is false, recovery and purge continue but new jobs are rejected.
ASYNC_MEDIA_ADMISSION_ENABLED=false
ASYNC_MEDIA_S3_REGION=us-east-1
ASYNC_MEDIA_S3_BUCKET=
ASYNC_MEDIA_S3_ENDPOINT=
# Bucket, normalized prefix, and API_KEY_HASH_SECRET form the durable object
# identity for every unexpired job. Do not rotate/rename them in place.
ASYNC_MEDIA_S3_PREFIX=unirouter-media
ASYNC_MEDIA_S3_FORCE_PATH_STYLE=false
ASYNC_MEDIA_WORKER_ID=
ASYNC_MEDIA_LEASE_SECONDS=300
ASYNC_MEDIA_PURGE_LEASE_SECONDS=60
ASYNC_MEDIA_POLL_MILLISECONDS=500
ASYNC_MEDIA_PROVIDER_TIMEOUT_SECONDS=180
ASYNC_MEDIA_MAX_ATTEMPTS=3
# HMAC secret for authenticating outbound notification Webhooks. Optional only
# for source development; customer deployments require at least 32 bytes.
UNIROUTE_NOTIFICATION_WEBHOOK_SIGNING_SECRET=
# Source/development compatibility only. Formal release binaries reject this
# legacy runtime trust root even when it is present.
LICENSE_PUBLIC_KEY=
# Source/development-only V1 key ring JSON, for example:
# {"license-2026-a":"base64-ed25519-public-key"}
# Formal release images embed this public ring at build time and reject a
# runtime override.
LICENSE_PUBLIC_KEYS=
# Stable deployment identity supplied to the License issuer. Required for an
# enforceable commercial License; missing/mismatch blocks new model traffic.
LICENSE_DEPLOYMENT_ID=
LICENSE_EXPIRY_WARNING_DAYS=30
LICENSE_REFRESH_SECONDS=30
# Source/development-only upgrade ring. Formal release images embed a separate
# upgrade trust root at build time and reject a runtime override. Private keys
# always stay offline.
# Example: {"upgrade-2026-a":"base64-ed25519-public-key"}
UPGRADE_PUBLIC_KEYS=
# Never enable this in a public deployment. It exists only for throwaway local
# development when the seeded admin/admin123456 account has not been rotated.
UNIROUTE_ALLOW_DEFAULT_ADMIN_LOGIN=false
# Comma-separated exact browser origins that may call the backend directly.
# Leave empty when the frontend and backend are same-origin through nginx/proxy.
# Do not use wildcards. Example for local Vite/dev frontend:
# ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_CORS_ALLOWED_ORIGINS=

# --- OIDC SSO (disabled by default) ---
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_PROVIDER_NAME=OIDC
OIDC_SCOPES=openid,email,profile
OIDC_ALLOWED_EMAIL_DOMAIN=
OIDC_AUTO_PROVISION=false
OIDC_DEFAULT_ORG_ID=
OIDC_DEFAULT_ROLE=viewer
OIDC_DEFAULT_PROJECT_SLUG=default
OIDC_USERNAME_CLAIM=preferred_username
OIDC_EMAIL_CLAIM=email
OIDC_ROLE_CLAIM=uniroute_role
OIDC_ORG_ID_CLAIM=uniroute_org_id

# --- Observability ---
# Keep enabled for the bundled Prometheus stack. Set METRICS_ALLOWED_CIDRS to
# restrict direct scrapes, or set METRICS_ENABLED=false to hide /metrics.
METRICS_ENABLED=true
METRICS_ALLOWED_CIDRS=
# Metadata-only request path events. Lower sample rate before high-volume
# production traffic if database write amplification becomes a concern.
TRACE_EVENTS_ENABLED=true
TRACE_EVENT_SAMPLE_RATE=1
# Trace event retention in days. Defaults to LOG_RETENTION_DAYS when unset.
# Set to 0 to skip trace-event cleanup while keeping metadata-only trace writes enabled.
TRACE_EVENT_RETENTION_DAYS=30
# Payload evidence state written to trace/log rows. Supported values:
# metadata_only, disabled. This does not enable raw prompt/response capture.
PAYLOAD_CAPTURE_MODE=metadata_only
# Optional metadata-only OTLP/HTTP trace export. It is off by default, has no
# credential/header support in B3, and never exports prompts, responses, actor
# references, channel names, upstream request IDs, credentials or cursors.
UNIROUTE_OTEL_EXPORT_ENABLED=false
# Exact traces endpoint, or an http(s) collector origin (which resolves to
# /v1/traces). Userinfo, query strings and fragments are rejected.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
UNIROUTE_OTEL_EXPORT_QUEUE_SIZE=256
UNIROUTE_OTEL_EXPORT_BATCH_SIZE=32
UNIROUTE_OTEL_EXPORT_FLUSH_INTERVAL_MS=500
UNIROUTE_OTEL_EXPORT_TIMEOUT_MS=2000
UNIROUTE_OTEL_EXPORT_MAX_RETRIES=2
# Shared secret required before UniRouter accepts X-UniRouter-* evidence context
# headers. Leave empty to ignore inbound trace/session/actor/delegation headers.
EVIDENCE_CONTEXT_TRUST_SECRET=
# Runtime Status Center metadata and external monitoring health/deep-link state.
RUNTIME_ENVIRONMENT=local
# Frontend build-time environment badge. Keep this aligned with
# RUNTIME_ENVIRONMENT when building the Nginx image.
VITE_DEPLOY_ENV=local
RUNTIME_DEPLOYMENT_MODE=single-node
RUNTIME_DEPLOYMENT_ROLE=stable
# Startup-selected live model route authority. Canonical is the default and has
# no runtime fallback. Legacy or verify are accepted only when the separate,
# strict compatibility switch is explicitly true. Before verify, run explicit
# model-route-authority apply then check for the sole customer org. Before
# canonical, run read-only check only; apply is rejected because legacy-to-
# canonical reconciliation is not a canonical writer. Drain old legacy-writer
# processes before cutover. The binary independently rechecks database authority
# before Redis, workers or HTTP bind; changing these values alone never repairs
# or cuts over model state.
MODEL_ROUTE_AUTHORITY=canonical
MODEL_ROUTE_COMPATIBILITY_ENABLED=false
# Source/dev fallback only. Formal release images inject immutable values with
# -ldflags; these environment values cannot override embedded build identity.
RUNTIME_VERSION=
RUNTIME_TREE=
RUNTIME_IMAGE_DIGEST=
RUNTIME_COMMIT=
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
# Grafana has its own admin account. Use a strong password in every shared or
# public deployment; do not leave it as admin/admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# --- Billing ---
# On-prem defaults to cost observation: calculate and retain request costs
# without wallet admission or customer debits. prepaid_enforced preserves the
# hosted/prepaid contract. budget_enforced is reserved and fails startup until
# project-budget admission is implemented end to end.
BILLING_MODE=cost_observation
# Upgrade-safe request pricing migration gate. legacy preserves the existing
# model_prices authority while Rate Card drafts are imported, independently
# reviewed and activated. Switch to rate_card only after readiness passes;
# rate_card mode fails closed and never falls back to legacy prices.
REQUEST_PRICING_AUTHORITY=legacy
# Minimum freeze amount in cents (¥0.10 = 10)
MIN_FREEZE_AMOUNT=10
# Safety factor for output cost estimation (1.5 = 50% buffer)
FREEZE_SAFETY_FACTOR=1.5
# Freeze timeout in seconds (auto-cancel if no settlement)
FREEZE_TIMEOUT_SECONDS=300
# Exchange rate: USD to CNY
EXCHANGE_RATE=7.25

# --- Rate Limiting ---
# Default RPM per API Key
DEFAULT_KEY_RPM=60
# Default RPS per API Key. Env var name is kept for compatibility.
DEFAULT_KEY_QPS=10

# Shared weighted workload capacity across every UniRouter replica. Ordinary
# Chat and Embeddings cost 1 unit; a long-lived stream costs 4. Short reserves
# prevent streams from occupying every unit, and bounded waits return 429 with
# Retry-After instead of building an unbounded in-process queue.
WORKLOAD_GLOBAL_CAPACITY=100
WORKLOAD_ORG_CAPACITY=10
WORKLOAD_GLOBAL_SHORT_RESERVE=10
WORKLOAD_ORG_SHORT_RESERVE=2
WORKLOAD_INTERACTIVE_WEIGHT=1
WORKLOAD_STREAM_WEIGHT=4
WORKLOAD_EMBEDDING_WEIGHT=1
WORKLOAD_INTERACTIVE_MAX_WAIT_MS=50
WORKLOAD_STREAM_MAX_WAIT_MS=250
WORKLOAD_EMBEDDING_MAX_WAIT_MS=50

# Active guardrail policies are retained separately from disabled history.
# The database trigger enforces these limits atomically across replicas; the
# runtime uses the same values for copy-on-write tenant snapshot bounds.
GUARDRAIL_ORG_ACTIVE_POLICY_LIMIT=256
GUARDRAIL_PLATFORM_ACTIVE_POLICY_LIMIT=256
GUARDRAIL_CACHED_POLICY_LIMIT=4096
GUARDRAIL_CACHED_TENANT_LIMIT=4096

# Application-authoritative synchronous payload profiles. Actual bytes are
# bounded even when Content-Length is missing or false. 64 MiB remains a
# platform hard maximum and is not a normal tenant knob.
CHAT_REQUEST_MAX_BYTES=8388608
EMBEDDINGS_REQUEST_MAX_BYTES=16777216
NONSTREAM_RESPONSE_MAX_BYTES=16777216
# Per-replica retained-byte budgets; the organization budget must not exceed
# the node budget. Distributed request admission remains a separate control.
PAYLOAD_NODE_INFLIGHT_BYTES=268435456
PAYLOAD_ORG_INFLIGHT_BYTES=67108864
# Login brute-force guard. Counts attempts by resolved client IP and a shared
# normalized-username bucket; Redis uncertainty fails closed with HTTP 503
# before password verification instead of bypassing the shared limit.
# With no trusted proxy CIDRs, resolution safely uses backend RemoteAddr only.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IP_REQUESTS=30
LOGIN_RATE_LIMIT_USER_REQUESTS=10
# Forwarded client-IP headers are ignored unless the direct peer is explicitly
# trusted. These source-Compose defaults are the fixed frontend and optional
# canary edge Nginx addresses on the dedicated internal network below.
UNIROUTER_INTERNAL_NETWORK_CIDR=172.30.250.0/24
UNIROUTER_INTERNAL_NETWORK_GATEWAY=172.30.250.1
UNIROUTER_FRONTEND_PROXY_IP=172.30.250.10
UNIROUTER_CANARY_PROXY_IP=172.30.250.11
TRUSTED_PROXY_CIDRS=172.30.250.10/32,172.30.250.11/32

# --- Failover ---
# Maximum provider dispatch retries after the first attempt (same-model only).
# Unusable candidates rejected before dispatch do not consume this budget.
MAX_RETRY_COUNT=1
# Circuit breaker: consecutive failures to trigger OPEN
CIRCUIT_BREAKER_THRESHOLD=5
# Circuit breaker: seconds in OPEN before trying HALF_OPEN
CIRCUIT_BREAKER_RECOVER_SECONDS=300
# Circuit breaker: traffic percentage in HALF_OPEN state
CIRCUIT_BREAKER_HALF_OPEN_PERCENT=10
# Key cooldown after 429 (seconds)
KEY_COOLDOWN_SECONDS=60
# Provider credential cooldown after 401/403 (seconds)
PROVIDER_AUTH_COOLDOWN_SECONDS=3600
# Consecutive transient failures before a provider key is marked invalid
PROVIDER_KEY_FAILURE_THRESHOLD=3
# Refresh immutable per-model routing snapshots at most once per replica in
# this interval. Database refresh failure may use the last known good snapshot
# only until ROUTING_SNAPSHOT_STALE_SECONDS, then routing fails closed.
ROUTING_SNAPSHOT_REFRESH_SECONDS=1
ROUTING_SNAPSHOT_STALE_SECONDS=30
# Cross-replica PostgreSQL lease for the one permitted HALF_OPEN probe.
ROUTING_HALF_OPEN_PROBE_LEASE_SECONDS=15
# Maximum eligible failover candidates in one gateway operation.
ROUTING_MAX_CANDIDATES=32
# Bound per-replica model snapshot memory; oldest snapshots are evicted first.
ROUTING_MAX_SNAPSHOTS=1024

# --- Streaming Transport ---
# Maximum bytes accepted in one upstream SSE line. This is a transport safety
# bound, not a prompt/response or billing limit.
STREAM_MAX_SSE_LINE_BYTES=2097152
# A blocked downstream write is abandoned after this many seconds. Heartbeats
# must be more frequent than this deadline.
STREAM_WRITE_IDLE_TIMEOUT_SECONDS=30
STREAM_HEARTBEAT_SECONDS=15
# Total provider stream lifetime. Long video jobs should use a future async job
# contract rather than raising this value without an operational review.
STREAM_MAX_DURATION_SECONDS=1800

# --- Backup ---
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_RETAIN_DAYS=7

# --- Cleanup ---
# Retention for call logs, settle/cancel transactions, and related cleanup.
LOG_RETENTION_DAYS=30

# --- Token Estimation ---
# Chinese characters per token
TOKEN_RATIO_ZH=1.5
# English characters per token
TOKEN_RATIO_EN=4

# --- Canary ---
# Set to "true" for canary instances that share the same database.
# Prevents the canary from running schema migrations (only stable instance should migrate).
SKIP_MIGRATION=false
