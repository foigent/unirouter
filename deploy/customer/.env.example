# Image references and this Compose/config directory are release artifacts.
# Use the exact references from the signed manifest/release note.
UNIROUTER_BACKEND_IMAGE=registry.example.invalid/unirouter/backend@sha256:REPLACE
UNIROUTER_FRONTEND_IMAGE=registry.example.invalid/unirouter/frontend@sha256:REPLACE
POSTGRES_IMAGE=postgres@sha256:REPLACE
REDIS_IMAGE=redis@sha256:REPLACE
PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE
GRAFANA_IMAGE=grafana/grafana@sha256:REPLACE

POSTGRES_USER=uniroute
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=uniroute
# URL-encode special characters from POSTGRES_PASSWORD before placing them here.
DB_DSN=postgres://uniroute:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/uniroute?sslmode=disable
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

JWT_SECRET=REPLACE_WITH_32_BYTE_RANDOM_VALUE
API_KEY_HASH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_VALUE
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_BYTES
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

LICENSE_PUBLIC_KEYS={"license-2026-a":"REPLACE_BASE64_ED25519_PUBLIC_KEY"}
LICENSE_DEPLOYMENT_ID=REPLACE_WITH_APPROVED_STABLE_DEPLOYMENT_ID
UPGRADE_PUBLIC_KEYS={"upgrade-2026-a":"REPLACE_BASE64_ED25519_PUBLIC_KEY"}

RUNTIME_ENVIRONMENT=production
RUNTIME_DEPLOYMENT_MODE=docker-compose
UNIROUTER_LISTEN_ADDRESS=127.0.0.1
UNIROUTER_HTTP_PORT=3000

OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
