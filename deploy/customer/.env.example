# Image references and this Compose/config directory are release artifacts.
# Use the exact references from the signed manifest/release note.
UNIROUTER_BACKEND_IMAGE=registry.example.invalid/unirouter/backend@sha256:REPLACE
UNIROUTER_FRONTEND_IMAGE=registry.example.invalid/unirouter/frontend@sha256:REPLACE
POSTGRES_IMAGE=postgres@sha256:REPLACE
REDIS_IMAGE=redis@sha256:REPLACE
PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE
GRAFANA_IMAGE=grafana/grafana@sha256:REPLACE

POSTGRES_USER=uniroute
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=uniroute
# URL-encode special characters from POSTGRES_PASSWORD before placing them here.
DB_DSN=postgres://uniroute:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/uniroute?sslmode=disable
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

JWT_SECRET=REPLACE_WITH_32_BYTE_RANDOM_VALUE
API_KEY_HASH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_VALUE
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_BYTES
# Optional Exact Response Cache runtime. Leave all three blank to keep it
# disabled. If enabled, inject two independent exact 32-byte secrets and one
# immutable non-secret version label; never reuse another UniRouter secret.
# V1 rotation deliberately cold-invalidates entries encrypted by the old
# version, which then age out under their bounded TTL.
RESPONSE_CACHE_INDEX_KEY=
RESPONSE_CACHE_ENCRYPTION_KEY=
RESPONSE_CACHE_KEY_VERSION=
UNIROUTE_NOTIFICATION_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# Bound Docker json-file logs for every long-running Compose service.
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=3

LICENSE_DEPLOYMENT_ID=REPLACE_WITH_APPROVED_STABLE_DEPLOYMENT_ID

RUNTIME_ENVIRONMENT=production
RUNTIME_DEPLOYMENT_MODE=docker-compose
# Customer installations observe calculated cost by default and never require
# a prepaid wallet balance. Set prepaid_enforced only for an explicitly agreed
# prepaid deployment contract; budget_enforced is not yet supported.
BILLING_MODE=cost_observation
# Keep legacy during upgrade. Change to rate_card only after complete active
# Rate Cards pass the per-model preflight; strict mode has no legacy fallback.
REQUEST_PRICING_AUTHORITY=legacy
# Keep disabled until the jointly sequenced X-Insight activation. When enabled,
# set one stable non-secret deployment identity such as prod.unirouter:stable-1.
COMPLETED_EXECUTION_FEED_ENABLED=false
COMPLETED_EXECUTION_FEED_SOURCE_INSTANCE=
COMPLETED_EXECUTION_FEED_REFERENCE_MODE=legacy
# The stable backend is the single Connector polling writer. Enable only with
# one fixed HTTPS control origin and an exact non-secret receiver binding map.
# Never put invitation/control tokens or the X-owned receiver bearer here.
XINSIGHT_CONNECTOR_AGENT_ENABLED=false
XINSIGHT_CONNECTOR_CONTROL_ORIGIN=
XINSIGHT_CONNECTOR_POLL_MILLISECONDS=1000
XINSIGHT_CONNECTOR_REQUEST_TIMEOUT_MILLISECONDS=5000
# Exact-case installation/deployment IDs plus a sha256: digest map to one exact
# IPv4 /32 or IPv6 /128. Keep this JSON on one line.
XINSIGHT_CONNECTOR_RECEIVER_BINDINGS_JSON=[]
# Image V1 is disabled by default. Credentials must come from an approved AWS
# SDK provider chain or deployment secret mount, never this checked-in template.
ASYNC_MEDIA_ENABLED=false
ASYNC_MEDIA_ADMISSION_ENABLED=false
ASYNC_MEDIA_S3_REGION=us-east-1
ASYNC_MEDIA_S3_BUCKET=
ASYNC_MEDIA_S3_ENDPOINT=
# Keep bucket, normalized prefix, and API_KEY_HASH_SECRET stable until every
# existing media job has expired and been purged; rotation needs a migration.
ASYNC_MEDIA_S3_PREFIX=unirouter-media
ASYNC_MEDIA_S3_FORCE_PATH_STYLE=false
ASYNC_MEDIA_WORKER_ID=
ASYNC_MEDIA_LEASE_SECONDS=300
ASYNC_MEDIA_PURGE_LEASE_SECONDS=60
ASYNC_MEDIA_POLL_MILLISECONDS=500
ASYNC_MEDIA_PROVIDER_TIMEOUT_SECONDS=180
ASYNC_MEDIA_MAX_ATTEMPTS=3
UNIROUTER_LISTEN_ADDRESS=127.0.0.1
UNIROUTER_HTTP_PORT=3000
# The formal customer template keeps the frontend on one deterministic /32 so
# the backend can trust only that proxy, not every container on the network.
UNIROUTER_INTERNAL_NETWORK_CIDR=172.30.250.0/24
UNIROUTER_INTERNAL_NETWORK_GATEWAY=172.30.250.1
UNIROUTER_FRONTEND_PROXY_IP=172.30.250.10
# Keep the frontend /32. The default gateway /32 covers an approved TLS proxy
# running on the same host while the published frontend port remains loopback-
# only. Add other edge proxy hop CIDRs only after verifying their source IP.
TRUSTED_PROXY_CIDRS=172.30.250.10/32,172.30.250.1/32

# Active guardrail policy and immutable snapshot bounds. Disabled policy
# history does not consume these quotas.
GUARDRAIL_ORG_ACTIVE_POLICY_LIMIT=256
GUARDRAIL_PLATFORM_ACTIVE_POLICY_LIMIT=256
GUARDRAIL_CACHED_POLICY_LIMIT=4096
GUARDRAIL_CACHED_TENANT_LIMIT=4096

OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
